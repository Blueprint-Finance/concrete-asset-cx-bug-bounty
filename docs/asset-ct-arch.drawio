        <mxCell id="assetct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="260" width="380" x="1850" y="220" as="geometry" />
        </mxCell>
        <mxCell id="assetct-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1B5E20;" value="🪙 AssetCT (ERC-20 Token)" vertex="1">
          <mxGeometry height="30" width="240" x="1920" y="240" as="geometry" />
        </mxCell>
        <mxCell id="assetct-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;• UUPS Upgradeable&#xa;• mint(amount) → MERCHANT_ROLE&#xa;• burn(amount) → MERCHANT_ROLE&#xa;&#xa;📍 Always 1:1 backed by QC ASSET&#xa;📍 Only ConcreteMerchant can&#xa;    mint/burn tokens" vertex="1">
          <mxGeometry height="180" width="330" x="1875" y="280" as="geometry" />
        </mxCell>
        <mxCell id="merchant" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2DFDB;strokeColor=#00796B;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="550" width="680" x="720" y="220" as="geometry" />
        </mxCell>
        <mxCell id="merchant-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#00695C;" value="📋 ConcreteMerchant" vertex="1">
          <mxGeometry height="35" width="280" x="920" y="240" as="geometry" />
        </mxCell>
        <mxCell id="merchant-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;🔐 ROLES:&#xa;   • DEFAULT_ADMIN_ROLE → contract upgrades&#xa;   • MERCHANT_MANAGER_ROLE → configuration&#xa;   • OPERATOR_ROLE → mint, claim, finalize operations&#xa;&#xa;📊 USER MAPPINGS:&#xa;   • userAccounts[userId] → EVM address&#xa;   • userVaults[userId] → optional private vault&#xa;   • totalMintedPerUser[userId] → cumulative minted&#xa;   • pendingQCRedemptionPerUser[userId]&#xa;&#xa;💰 DEPOSIT FUNCTIONS:&#xa;   • mintAndDeposit(userId, amount, txHash)&#xa;&#xa;🔄 YIELD FUNCTIONS:&#xa;   • initiateYieldAccrual(vault, amountYieldToken, nonce)&#xa;   • finalizeYieldAccrual(vault, nonce, amountAsset, txHash)&#xa;&#xa;🔓 REDEMPTION FUNCTIONS:&#xa;   • claimVaultWithdrawal(userId, epochID)&#xa;   • finalizeQCRedemption(userId, amount, txHash)" vertex="1">
          <mxGeometry height="460" width="620" x="750" y="285" as="geometry" />
        </mxCell>
        <mxCell id="storage-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="260" width="300" x="1085" y="325" as="geometry" />
        </mxCell>
        <mxCell id="storage-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#01579B;" value="📦 Merchant Storage Mappings" vertex="1">
          <mxGeometry height="25" width="220" x="1140" y="350" as="geometry" />
        </mxCell>
        <mxCell id="storage-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Courier New;" value="userAccounts[bytes32] → address&#xa;userVaults[bytes32] → IERC4626&#xa;totalMintedPerUser[bytes32] → uint256&#xa;pendingQCRedemptionPerUser[bytes32]&#xa;pendingAssetCtRedemptionPerReceiver[addr]&#xa;qcTxToAmount[bytes32] → uint256&#xa;pendingYieldByNonce[uint256] → uint256&#xa;totalPendingYield → uint256&#xa;vaultYieldConfigs[vault] → struct" vertex="1">
          <mxGeometry height="180" width="260" x="1105" y="385" as="geometry" />
        </mxCell>
        <mxCell id="vault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEDC8;strokeColor=#558B2F;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="300" width="500" x="720" y="880" as="geometry" />
        </mxCell>
        <mxCell id="vault-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#33691E;" value="🏛️ ConcreteAssetCtVault (ERC-4626)" vertex="1">
          <mxGeometry height="30" width="340" x="800" y="900" as="geometry" />
        </mxCell>
        <mxCell id="vault-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;• Async vault with epoch-based withdrawals&#xa;• deposit(assets, receiver) → MERCHANT_ROLE only&#xa;• mint(shares, receiver) → MERCHANT_ROLE only&#xa;• claimWithdrawal(user, epochIDs) → MERCHANT_ROLE&#xa;&#xa;👤 Users hold vault shares (ERC-20)&#xa;📈 Share value reflects accumulated yield/loss&#xa;📍 User calls withdraw() to request redemption" vertex="1">
          <mxGeometry height="210" width="440" x="750" y="945" as="geometry" />
        </mxCell>
        <mxCell id="user-vault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="160" width="380" x="745" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="user-vault-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#616161;" value="🏛️ Per-User Private Vault (Optional)" vertex="1">
          <mxGeometry height="30" width="280" x="795" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="user-vault-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;• Same ERC-4626 interface&lt;br&gt;• Isolated deposits per user&lt;br&gt;• Set via setUserVault(userId, vault)" vertex="1">
          <mxGeometry height="90" width="320" x="775" y="1275" as="geometry" />
        </mxCell>
        <mxCell id="strategy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#EF6C00;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="380" width="460" x="1320" y="880" as="geometry" />
        </mxCell>
        <mxCell id="strategy-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#E65100;" value="⚡ AssetCtMultisigStrategy" vertex="1">
          <mxGeometry height="30" width="280" x="1410" y="900" as="geometry" />
        </mxCell>
        <mxCell id="strategy-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;• Linked to specific vault&lt;br&gt;• Manages yield token accumulation&lt;br&gt;• Coordinates with ConcreteMerchant&lt;div&gt;* Manages a borrow position collateralized with assetCT&lt;br&gt;&lt;br&gt;📊 KEY FUNCTIONS:&lt;br&gt;   • initiateMerchantYieldAccrual(amount, nonce)&lt;br&gt;   • finalizeMerchantYieldAccrual(nonce, amountAsset)&lt;br&gt;   • adjustTotalAssets(diff, accountingNonce)&lt;br&gt;&lt;br&gt;📍 Pending yield tracking per nonce&lt;br&gt;📍 Receives AssetCT after yield finalization&lt;br&gt;📍 Transfers yield token to multisig via merchant&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="400" x="1350" y="945" as="geometry" />
        </mxCell>
        <mxCell id="yield-multisig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#FF8000;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="280" width="300" x="1880" y="880" as="geometry" />
        </mxCell>
        <mxCell id="yield-multisig-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#6A1B9A;" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;🔐 Yield Multisig&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="180" x="1940" y="900" as="geometry" />
        </mxCell>
        <mxCell id="yield-multisig-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;• Receives yield tokens from&#xa;  strategy via merchant&#xa;• Coordinates swap with QC&#xa;• Holds AssetCT after yield mint&#xa;&#xa;📍 Bridge between on-chain &amp; QC&#xa;📍 Controlled by trusted operators" vertex="1">
          <mxGeometry height="190" width="250" x="1905" y="945" as="geometry" />
        </mxCell>
