          <mxGeometry height="30" width="340" x="-70" y="210" as="geometry" />
        </mxCell>
        <mxCell id="qc-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;• Holds ALL backing ASSET (1:1 ratio)&#xa;• User accounts for deposits/withdrawals&#xa;• Swaps yield tokens → ASSET&#xa;• Issues redemptions to users&#xa;• Tracks txHash for reconciliation" vertex="1">
          <mxGeometry height="170" width="400" x="-100" y="250" as="geometry" />
