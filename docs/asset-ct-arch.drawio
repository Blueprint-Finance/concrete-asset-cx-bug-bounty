          <mxGeometry height="30" width="360" x="-90" y="580" as="geometry" />
        </mxCell>
        <mxCell id="backend-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;• Monitors QC deposits (txHash)&#xa;• Triggers OPERATOR_ROLE actions&#xa;• Processes vault epochs&#xa;• Coordinates yield swaps" vertex="1">
