          <mxGeometry height="180" width="700" x="760" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="yield-summary-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#E65100;" value="🟠 YIELD ACCRUAL FLOW (Y1-Y7)" vertex="1">
          <mxGeometry height="30" width="320" x="780" y="2025" as="geometry" />
        </mxCell>
        <mxCell id="yield-summary-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="Y1: Strategy calls initiateMerchantYieldAccrual(amount, nonce)&#xa;Y2: Merchant.initiateYieldAccrual() records pending yield&#xa;Y3: Yield token transferred from Strategy → Yield Multisig (to QC env)&#xa;Y4: OFF-CHAIN: Multisig sends yield token to QC, QC swaps → ASSET&#xa;Y5: Backend/OPERATOR calls finalizeYieldAccrual(vault, nonce, amountAsset, txHash)&#xa;Y6: Merchant mints AssetCT (yield value) → transfers to Strategy (from QC env)&#xa;Y7: Strategy calls adjustTotalAssets() - vault share value increases" vertex="1">
          <mxGeometry height="120" width="660" x="780" y="2065" as="geometry" />
        </mxCell>
        <mxCell id="redeem-summary-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="180" width="780" x="1490" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="redeem-summary-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#B71C1C;" value="🔴 REDEMPTION FLOW (R1-R6)" vertex="1">
          <mxGeometry height="30" width="300" x="1510" y="2025" as="geometry" />
        </mxCell>
        <mxCell id="redeem-summary-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="R1: User calls vault.withdraw() / redeem() - creates withdrawal request in vault&#xa;R2: Backend processes epoch, closes epoch on vault&#xa;R3: OPERATOR calls claimVaultWithdrawal(userId, epochID) → vault.claimWithdrawal()&#xa;R4: Merchant receives AssetCT, calls AssetCT.burn(amount) - burns tokens&#xa;R5: OFF-CHAIN: QC sends ASSET to user account&#xa;R6: OPERATOR calls finalizeQCRedemption(userId, amount, txHash) - finalizes tracking" vertex="1">
          <mxGeometry height="120" width="740" x="1510" y="2065" as="geometry" />
        </mxCell>
        <mxCell id="accounting-summary-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="100" width="650" x="80" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="accounting-summary-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0D47A1;" value="🔵 ACCOUNTING" vertex="1">
          <mxGeometry height="30" width="180" x="100" y="2215" as="geometry" />
        </mxCell>
        <mxCell id="accounting-summary-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="A1: Strategy calls adjustTotalAssets(diff, accountingNonce)&#xa;     → Updates vault total assets → Changes share value for all holders" vertex="1">
          <mxGeometry height="45" width="610" x="100" y="2250" as="geometry" />
        </mxCell>
        <mxCell id="keypoints-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="100" width="1510" x="760" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="keypoints-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#6A1B9A;" value="📍 KEY POINTS" vertex="1">
          <mxGeometry height="30" width="180" x="780" y="2215" as="geometry" />
        </mxCell>
        <mxCell id="keypoints-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="• txHash prevents replay attacks - each QC transaction recorded on-chain    • All AssetCT is 1:1 backed by ASSET in Qualified Custodian    • Epoch-based async withdrawals&#xa;• Yield flows: Strategy → Merchant → Multisig → QC (swap) → Merchant (mint) → Strategy (adjust)    • Only ConcreteMerchant can mint/burn AssetCT and interact with vault" vertex="1">
          <mxGeometry height="45" width="1470" x="780" y="2250" as="geometry" />
        </mxCell>
