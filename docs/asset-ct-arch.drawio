        <mxCell id="users-content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" value="━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;• Deposit ASSET to QC account&lt;br&gt;• Receive vault shares on-chain&lt;br&gt;• Request withdrawals from vault&lt;br&gt;• Receive ASSET from QC on redemption" vertex="1">
