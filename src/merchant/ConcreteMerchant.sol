pragma solidity ^0.8.24;

import {Initializable} from "@openzeppelin-upgradeable/proxy/utils/Initializable.sol";
import {UUPSUpgradeable} from "@openzeppelin-upgradeable/proxy/utils/UUPSUpgradeable.sol";
import {PausableUpgradeable} from "@openzeppelin-upgradeable/utils/PausableUpgradeable.sol";
import {AccessControlUpgradeable} from "@openzeppelin-upgradeable/access/AccessControlUpgradeable.sol";
import {
    AccessControlEnumerableUpgradeable
} from "@openzeppelin-upgradeable/access/extensions/AccessControlEnumerableUpgradeable.sol";
import {IAccessControl} from "@openzeppelin-contracts/access/IAccessControl.sol";
import {IERC4626} from "@openzeppelin-contracts/interfaces/IERC4626.sol";
import {IERC20} from "@openzeppelin-contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin-contracts/token/ERC20/utils/SafeERC20.sol";
import {EnumerableSet} from "@openzeppelin-contracts/utils/structs/EnumerableSet.sol";
import {AssetCX} from "../AssetCX.sol";
import {ConcreteMerchantStorageLib} from "../lib/ConcreteMerchantStorageLib.sol";
import {TimelockIntegrationLib} from "@concrete-xyz/earn-v2-core/src/lib/TimelockIntegrationLib.sol";
import {ITimelockProtected} from "@concrete-xyz/earn-v2-core/src/interface/ITimelockProtected.sol";
import {IConcreteMerchant} from "../interface/IConcreteMerchant.sol";
import {IMultisigStrategy} from "../interface/IMultisigStrategy.sol";
import {IAssetCXVault} from "../interface/IAssetCXVault.sol";
import {IWhitelistHook} from "../interface/IWhitelistHook.sol";

/**
 * @title ConcreteMerchant
 * @notice Implementation of the ConcreteMerchant contract
 * @dev ConcreteMerchant is a contract that manages the assetCX supply.
 *  It mints and deposits into a vault the assetCX tokens on behalf of users based on deposits into QC reserves. It handles user redemptions by burning the assetCX tokens. It handles accounting of yield generated by the vault.
 */
contract ConcreteMerchant is
    Initializable,
    PausableUpgradeable,
    AccessControlEnumerableUpgradeable,
    UUPSUpgradeable,
    ITimelockProtected,
    IConcreteMerchant
{
    using SafeERC20 for IERC20;
    using EnumerableSet for EnumerableSet.AddressSet;
    bytes32 public constant MERCHANT_MANAGER_ROLE = keccak256("MERCHANT_MANAGER_ROLE");
    bytes32 public constant OPERATOR_ROLE = keccak256("OPERATOR_ROLE");
    bytes32 public constant PAUSER_ROLE = keccak256("PAUSER_ROLE");

    /// @notice Hard cap on the number of concurrently whitelisted yield tokens.
    uint256 public constant MAX_WHITELISTED_YIELD_TOKENS = 20;

    /// @dev Validates and consumes the matured timelock schedule entry for the
    ///      calling function. No-op while timelock enforcement is not yet active.
    function _enforceDelay() internal {
        TimelockIntegrationLib.enforceDelay(msg.sig, msg.data[4:]);
    }

    /// @dev Applied to privileged functions that require a prior {ITimelock.propose}
    ///      followed by the matured tier delay before they can execute.
    modifier afterDelay() {
        _enforceDelay();
        _;
    }

    /**
     * @dev Constructor that disables initializers
     */
    constructor() {
        _disableInitializers();
    }

    /// @inheritdoc IConcreteMerchant
    function initialize(address admin, AssetCX assetCX_, IERC4626 assetCXVault_, address timelock_)
        external
        initializer
    {
        if (admin == address(0) || address(assetCX_) == address(0) || address(assetCXVault_) == address(0)) {
            revert InvalidAddress();
        }

        if (assetCXVault_.asset() != address(assetCX_)) {
            revert InvalidVaultAsset();
        }

        __Pausable_init_unchained();
        __AccessControlEnumerable_init_unchained();
        __UUPSUpgradeable_init_unchained();

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();
        $.assetCX = assetCX_;
        $.assetCXVault = assetCXVault_;

        _setRoleAdmin(MERCHANT_MANAGER_ROLE, DEFAULT_ADMIN_ROLE);
        _setRoleAdmin(OPERATOR_ROLE, MERCHANT_MANAGER_ROLE);
        _setRoleAdmin(PAUSER_ROLE, DEFAULT_ADMIN_ROLE);

        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(MERCHANT_MANAGER_ROLE, admin);
        _grantRole(PAUSER_ROLE, admin);

        if (timelock_ != address(0)) TimelockIntegrationLib.setTimelock(timelock_);
    }

    /// @inheritdoc IConcreteMerchant
    function reinitializeV3(
        address tempAdminA,
        address tempAdminB,
        address[] calldata merchantManagers,
        address[] calldata operators,
        address[] calldata pausers
    ) external reinitializer(3) onlyRole(DEFAULT_ADMIN_ROLE) {
        if (tempAdminA == address(0) || tempAdminB == address(0)) revert InvalidAddress();
        // A stand-in that already holds the role would have its grant short-circuit and then be
        // revoked below, silently removing an existing admin. The caller always holds the role, so
        // this also rejects the caller naming itself. A repeated stand-in fails to lift the count.
        if (hasRole(DEFAULT_ADMIN_ROLE, tempAdminA)) revert InvalidTempAdmin(tempAdminA);
        if (hasRole(DEFAULT_ADMIN_ROLE, tempAdminB)) revert InvalidTempAdmin(tempAdminB);
        if (tempAdminA == tempAdminB) revert InvalidTempAdmin(tempAdminB);

        // `DEFAULT_ADMIN_ROLE` cannot use the drop-and-re-grant path the other roles use: the
        // caller is the sole admin and is not yet enumerated, so `_revokeRole` would see a member
        // count of zero and trip the last-admin guard. Two throw-away admins lift the count to two
        // first, which lets the caller be dropped and re-entered, after which both are removed
        // again. Neither temp address is ever usable — the whole sequence is internal to this one
        // transaction, and the exit assertion below proves both are gone.
        _grantRole(DEFAULT_ADMIN_ROLE, tempAdminA);
        _grantRole(DEFAULT_ADMIN_ROLE, tempAdminB);

        _revokeRole(DEFAULT_ADMIN_ROLE, msg.sender);
        _grantRole(DEFAULT_ADMIN_ROLE, msg.sender);

        _revokeRole(DEFAULT_ADMIN_ROLE, tempAdminA);
        _revokeRole(DEFAULT_ADMIN_ROLE, tempAdminB);

        _reenterRoleMembers(MERCHANT_MANAGER_ROLE, merchantManagers);
        _reenterRoleMembers(OPERATOR_ROLE, operators);
        _reenterRoleMembers(PAUSER_ROLE, pausers);

        // The admin set must end up holding exactly the caller: one member, and that member is the
        // admin that entered this call. Anything else means a temp admin survived.
        uint256 adminCount = getRoleMemberCount(DEFAULT_ADMIN_ROLE);
        address enumeratedAdmin = adminCount == 1 ? getRoleMember(DEFAULT_ADMIN_ROLE, 0) : address(0);
        if (adminCount != 1 || enumeratedAdmin != msg.sender) {
            revert AdminBackfillMismatch(adminCount, enumeratedAdmin);
        }

        emit RoleMembershipBackfilled(DEFAULT_ADMIN_ROLE, adminCount);
    }

    /// @dev Seeds the enumerable membership set of `role` with accounts that already hold it, by
    ///      dropping and immediately re-granting each one: `_grantRole` short-circuits for an
    ///      existing holder and so would never reach the set. Not usable for `DEFAULT_ADMIN_ROLE`,
    ///      which {reinitializeV3} handles through its own temporary-admin sequence. Used only by
    ///      {reinitializeV3}.
    function _reenterRoleMembers(bytes32 role, address[] calldata members) private {
        uint256 len = members.length;
        for (uint256 i = 0; i < len; ++i) {
            address account = members[i];
            if (!hasRole(role, account)) revert NotACurrentRoleHolder(role, account);
            _revokeRole(role, account);
            _grantRole(role, account);
        }

        emit RoleMembershipBackfilled(role, getRoleMemberCount(role));
    }

    /// @inheritdoc ITimelockProtected
    function setTimelock(address timelock_) external override afterDelay onlyRole(DEFAULT_ADMIN_ROLE) {
        if (timelock_ == address(0)) revert ZeroAddress();
        TimelockIntegrationLib.setTimelock(timelock_);
        emit TimelockSet(timelock_);
    }

    /// @inheritdoc ITimelockProtected
    function activateTimelock() external override onlyRole(DEFAULT_ADMIN_ROLE) {
        address tl = TimelockIntegrationLib.activateTimelock();
        emit TimelockActivated(tl);
    }

    /// @inheritdoc ITimelockProtected
    function getTimelock() external view override returns (address timelock_, bool active_) {
        return TimelockIntegrationLib.state();
    }

    /// @dev Routes role grants through the timelock so that `MERCHANT_MANAGER_ROLE`
    ///      and `OPERATOR_ROLE` membership cannot change without a queued proposal.
    function grantRole(bytes32 role, address account)
        public
        virtual
        override(AccessControlUpgradeable, IAccessControl)
    {
        if (role != PAUSER_ROLE) {
            _enforceDelay();
        }
        super.grantRole(role, account);
    }

    /// @notice Prevents removing the last `DEFAULT_ADMIN_ROLE`, which would leave the merchant
    ///         permanently without an admin and therefore unupgradeable.
    /// @dev Both {revokeRole} and {renounceRole} funnel through here, so this single override
    ///      blocks self-revoke, self-renounce and admin-revokes-admin alike. Every revoke or
    ///      renounce of `DEFAULT_ADMIN_ROLE` reverts while the enumerated member count is one or
    ///      less, including for an admin that is not enumerated: the guard reads only
    ///      `getRoleMemberCount`, not `hasRole`.
    function _revokeRole(bytes32 role, address account)
        internal
        virtual
        override(AccessControlEnumerableUpgradeable)
        returns (bool)
    {
        if (role == DEFAULT_ADMIN_ROLE && getRoleMemberCount(DEFAULT_ADMIN_ROLE) <= 1) {
            revert CannotRemoveLastRoleAdmin();
        }
        return super._revokeRole(role, account);
    }

    /// @inheritdoc IConcreteMerchant
    function pause() external onlyRole(PAUSER_ROLE) {
        _pause();
    }

    /// @inheritdoc IConcreteMerchant
    function unpause() external afterDelay onlyRole(PAUSER_ROLE) {
        _unpause();
    }

    /// @inheritdoc IConcreteMerchant
    function assetCX() public view returns (AssetCX) {
        return ConcreteMerchantStorageLib.fetch().assetCX;
    }

    /// @inheritdoc IConcreteMerchant
    function assetCXVault() public view returns (IERC4626) {
        return ConcreteMerchantStorageLib.fetch().assetCXVault;
    }

    /// @inheritdoc IConcreteMerchant
    function userVault(bytes32 userId) public view returns (IERC4626) {
        return ConcreteMerchantStorageLib.fetch().userVaults[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function getUserAccount(bytes32 userId) public view returns (address) {
        return ConcreteMerchantStorageLib.fetch().userAccounts[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function isUserAccountUsed(address user) external view returns (bool) {
        return ConcreteMerchantStorageLib.fetch().usedUserAccounts[user];
    }

    /// @inheritdoc IConcreteMerchant
    function userData(bytes32 userId) public view returns (bytes memory) {
        return ConcreteMerchantStorageLib.fetch().userData[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function setUserAccount(bytes32 userId, address user) external afterDelay onlyRole(MERCHANT_MANAGER_ROLE) {
        if (user == address(0)) {
            revert InvalidAddress();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        uint256 activeShares = $.mintedVaultShares[userId];
        if (activeShares > 0) {
            revert UserHasActiveDeposits(userId, activeShares);
        }

        // Free the previously-bound address (if any) so it can be reassigned.
        address previousAccount = $.userAccounts[userId];
        if (previousAccount != address(0)) {
            $.usedUserAccounts[previousAccount] = false;
        }

        if ($.usedUserAccounts[user]) {
            revert UserAccountAlreadyUsed(user);
        }

        $.userAccounts[userId] = user;
        $.usedUserAccounts[user] = true;

        emit UserAccountSet(userId, user);
    }

    /// @inheritdoc IConcreteMerchant
    function setUserVault(bytes32 userId, IERC4626 vault) external afterDelay onlyRole(MERCHANT_MANAGER_ROLE) {
        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();
        if ($.userAccounts[userId] == address(0)) {
            revert UnknownUser(userId);
        }
        if (address(vault) == address(0)) {
            revert InvalidAddress();
        }
        if (vault.asset() != address($.assetCX)) {
            revert InvalidVaultAsset();
        }

        uint256 activeShares = $.mintedVaultShares[userId];
        if (activeShares > 0) {
            revert UserHasActiveDeposits(userId, activeShares);
        }

        $.userVaults[userId] = vault;

        emit UserVaultSet(userId, address(vault));
    }

    /// @inheritdoc IConcreteMerchant
    function removeUserVault(bytes32 userId) external afterDelay onlyRole(MERCHANT_MANAGER_ROLE) {
        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        uint256 activeShares = $.mintedVaultShares[userId];
        if (activeShares > 0) {
            revert UserHasActiveDeposits(userId, activeShares);
        }

        $.userVaults[userId] = IERC4626(address(0));

        emit UserVaultRemoved(userId);
    }

    /// @inheritdoc IConcreteMerchant
    function setUserData(bytes32 userId, bytes calldata data) external afterDelay onlyRole(MERCHANT_MANAGER_ROLE) {
        ConcreteMerchantStorageLib.fetch().userData[userId] = data;
        emit UserDataSet(userId, data);
    }

    /// @inheritdoc IConcreteMerchant
    function emergencyMigrateUserAccount(bytes32 userId, address newAccount)
        external
        afterDelay
        onlyRole(DEFAULT_ADMIN_ROLE)
    {
        if (newAccount == address(0)) {
            revert InvalidAddress();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        address oldAccount = $.userAccounts[userId];
        if (oldAccount == address(0)) {
            revert UnknownUser(userId);
        }

        // Enforce the same address-uniqueness invariant as `setUserAccount`. The old account stays
        // flagged as used so a compromised address can never be revived for any userId.
        if ($.usedUserAccounts[newAccount]) {
            revert UserAccountAlreadyUsed(newAccount);
        }

        uint256 sharesToMigrate = $.mintedVaultShares[userId];
        if (sharesToMigrate == 0) {
            revert InvalidAmount();
        }

        IAssetCXVault vault = IAssetCXVault(address(_resolveVault($, userId)));

        // Verify old account has sufficient share balance
        uint256 oldAccountBalance = vault.balanceOf(oldAccount);
        if (oldAccountBalance < sharesToMigrate) {
            revert InsufficientShareBalance(sharesToMigrate, oldAccountBalance);
        }

        // Update whitelist
        IWhitelistHook whitelistHook = IWhitelistHook(vault.getHook());
        whitelistHook.setUserWhitelisted(newAccount);
        whitelistHook.removeUserFromWhitelist(oldAccount);

        $.userAccounts[userId] = newAccount;
        $.usedUserAccounts[newAccount] = true;

        // Transfer shares from old account to new account (requires prior approval)
        IERC20(address(vault)).safeTransferFrom(oldAccount, newAccount, sharesToMigrate);

        emit EmergencyUserAccountMigrated(userId, oldAccount, newAccount, sharesToMigrate);
    }

    /// @inheritdoc IConcreteMerchant
    function totalMinted(bytes32 userId) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().totalMintedPerUser[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function totalBurned(bytes32 userId) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().totalBurnedPerUser[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function mintedVaultShares(bytes32 userId) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().mintedVaultShares[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function pendingQCRedemption(bytes32 userId) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().pendingQCRedemptionPerUser[userId];
    }

    /// @inheritdoc IConcreteMerchant
    function totalPendingQCRedemption() external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().totalPendingQCRedemption;
    }

    /// @inheritdoc IConcreteMerchant
    function isYieldTokenWhitelisted(address token) external view returns (bool) {
        return ConcreteMerchantStorageLib.fetch().whitelistedYieldTokens.contains(token);
    }

    /// @inheritdoc IConcreteMerchant
    function getWhitelistedYieldTokens() external view returns (address[] memory) {
        return ConcreteMerchantStorageLib.fetch().whitelistedYieldTokens.values();
    }

    /// @inheritdoc IConcreteMerchant
    function yieldTokenForPendingYieldNonce(uint256 nonce) external view returns (address) {
        return ConcreteMerchantStorageLib.fetch().pendingYieldTokenByNonce[nonce];
    }

    /// @inheritdoc IConcreteMerchant
    function totalPendingYieldByToken(address token) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().totalPendingYieldByToken[token];
    }

    /// @inheritdoc IConcreteMerchant
    function pendingYieldForVaultByToken(address vault, address token) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().pendingYieldPerVaultByToken[vault][token];
    }

    /// @inheritdoc IConcreteMerchant
    function vaultYieldStrategy(address vault) external view returns (address) {
        return ConcreteMerchantStorageLib.fetch().vaultYieldConfigs[vault].strategy;
    }

    /// @inheritdoc IConcreteMerchant
    function vaultYieldMultisig(address vault) external view returns (address) {
        return ConcreteMerchantStorageLib.fetch().vaultYieldConfigs[vault].yieldMultisig;
    }

    /// @inheritdoc IConcreteMerchant
    function getNextYieldNonce() external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().nextYieldNonce;
    }

    /// @inheritdoc IConcreteMerchant
    function pendingYield(uint256 nonce) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().pendingYieldByNonce[nonce];
    }

    /// @inheritdoc IConcreteMerchant
    function pendingAssetCxRedemption(address receiver) external view returns (uint256) {
        return ConcreteMerchantStorageLib.fetch().pendingAssetCxRedemptionPerReceiver[receiver];
    }

    /// @inheritdoc IConcreteMerchant
    function mintAndDeposit(bytes32 userId, uint256 amount, bytes32 txHash)
        external
        whenNotPaused
        onlyRole(OPERATOR_ROLE)
        returns (uint256 shares)
    {
        if (txHash == bytes32(0)) {
            revert InvalidTxHash();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        address recipient = $.userAccounts[userId];
        if (recipient == address(0)) {
            revert UnknownUser(userId);
        }

        if ($.qcTxToAmount[txHash] != 0) {
            revert TxHashAlreadyUsed(txHash);
        }

        if (amount == 0) {
            revert InvalidAmount();
        }

        AssetCX token = $.assetCX;
        IERC4626 vault = _resolveVault($, userId);

        $.totalMintedPerUser[userId] = $.totalMintedPerUser[userId] + amount;
        $.qcTxToAmount[txHash] = amount;

        token.mint(amount);

        IERC20 tokenInterface = IERC20(address(token));
        SafeERC20.forceApprove(tokenInterface, address(vault), amount);
        shares = vault.deposit(amount, recipient);
        SafeERC20.forceApprove(tokenInterface, address(vault), 0);
        $.mintedVaultShares[userId] += shares;

        emit MintAndDeposit(userId, amount, txHash);
    }

    /// @inheritdoc IConcreteMerchant
    function setYieldTokenWhitelisted(address token, bool whitelisted)
        external
        afterDelay
        onlyRole(MERCHANT_MANAGER_ROLE)
    {
        if (token == address(0)) revert InvalidAddress();

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();
        if (whitelisted) {
            _addYieldTokenToWhitelist($, token);
        } else {
            _removeYieldTokenFromWhitelist($, token);
        }
    }

    function _addYieldTokenToWhitelist(ConcreteMerchantStorageLib.Storage storage $, address token) internal {
        if ($.whitelistedYieldTokens.length() >= MAX_WHITELISTED_YIELD_TOKENS) {
            revert YieldTokenWhitelistFull(MAX_WHITELISTED_YIELD_TOKENS);
        }
        if (!$.whitelistedYieldTokens.add(token)) revert YieldTokenAlreadyWhitelisted(token);
        emit YieldTokenWhitelisted(token, true);
    }

    /// @dev Reverts with {PendingYieldForVault} on the first whitelisted token that
    ///      still has non-zero pending for `vault`.
    function _requireNoPendingYieldForVault(ConcreteMerchantStorageLib.Storage storage $, address vault) internal view {
        uint256 tokenCount = $.whitelistedYieldTokens.length();
        for (uint256 i = 0; i < tokenCount; ++i) {
            address token = $.whitelistedYieldTokens.at(i);
            uint256 pending = $.pendingYieldPerVaultByToken[vault][token];
            if (pending > 0) {
                revert PendingYieldForVault(vault, token, pending);
            }
        }
    }

    function _removeYieldTokenFromWhitelist(ConcreteMerchantStorageLib.Storage storage $, address token) internal {
        uint256 pendingAcrossVaults = $.totalPendingYieldByToken[token];
        if (pendingAcrossVaults > 0) revert PendingYieldForToken(token, pendingAcrossVaults);
        if (!$.whitelistedYieldTokens.remove(token)) revert YieldTokenNotWhitelisted(token);
        emit YieldTokenWhitelisted(token, false);
    }

    /// @inheritdoc IConcreteMerchant
    function setVaultYieldConfig(address vault, address strategy_, address yieldMultisig_)
        external
        afterDelay
        onlyRole(MERCHANT_MANAGER_ROLE)
    {
        if (vault == address(0) || strategy_ == address(0) || yieldMultisig_ == address(0)) {
            revert InvalidAddress();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        _requireNoPendingYieldForVault($, vault);

        if (IERC4626(vault).asset() != address($.assetCX)) {
            revert InvalidVaultAsset();
        }

        IMultisigStrategy strategy = IMultisigStrategy(strategy_);
        address strategyVault = strategy.getVault();
        if (strategyVault != vault) {
            revert StrategyVaultMismatch(strategyVault, vault);
        }

        $.vaultYieldConfigs[vault] =
            ConcreteMerchantStorageLib.VaultYieldConfig({strategy: strategy_, yieldMultisig: yieldMultisig_});

        emit VaultYieldConfigSet(vault, strategy_, yieldMultisig_);
    }

    /// @inheritdoc IConcreteMerchant
    function claimVaultWithdrawal(bytes32 userId, uint256 epochID)
        external
        whenNotPaused
        onlyRole(OPERATOR_ROLE)
        returns (uint256 amountClaimed)
    {
        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        address user = $.userAccounts[userId];
        if (user == address(0)) {
            revert UnknownUser(userId);
        }

        IAssetCXVault vault = IAssetCXVault(address(_resolveVault($, userId)));
        AssetCX token = $.assetCX;

        uint256 expectedAssets = vault.getUserEpochRequestInAssets(user, epochID);
        {
            uint256 requestedShares = vault.getUserEpochRequest(user, epochID);
            $.mintedVaultShares[userId] =
                requestedShares > $.mintedVaultShares[userId] ? 0 : $.mintedVaultShares[userId] - requestedShares;
        }
        uint256 balanceBefore = token.balanceOf(address(this));

        uint256[] memory epochIDs = new uint256[](1);
        epochIDs[0] = epochID;
        vault.claimWithdrawal(user, epochIDs);

        uint256 receivedAssets = token.balanceOf(address(this)) - balanceBefore;

        if (receivedAssets != expectedAssets) {
            revert ClaimAmountMismatch(expectedAssets, receivedAssets);
        }

        token.burn(receivedAssets);

        $.totalBurnedPerUser[userId] += receivedAssets;

        uint256 userPending = $.pendingQCRedemptionPerUser[userId] + receivedAssets;
        $.pendingQCRedemptionPerUser[userId] = userPending;
        uint256 totalPending = $.totalPendingQCRedemption + receivedAssets;
        $.totalPendingQCRedemption = totalPending;

        emit PendingQCRedemption(userId, epochID, receivedAssets, userPending, totalPending);
        return receivedAssets;
    }

    /// @inheritdoc IConcreteMerchant
    function finalizeQCRedemption(bytes32 userId, uint256 amount, bytes32 txHash)
        external
        whenNotPaused
        onlyRole(OPERATOR_ROLE)
    {
        if (txHash == bytes32(0)) {
            revert InvalidTxHash();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        uint256 pendingForUser = $.pendingQCRedemptionPerUser[userId];
        if (amount == 0 || amount > pendingForUser) {
            revert WrongRedemptionAmount(amount, pendingForUser);
        }

        if ($.qcTxToAmount[txHash] != 0) {
            revert TxHashAlreadyUsed(txHash);
        }

        uint256 userPending = pendingForUser - amount;
        $.pendingQCRedemptionPerUser[userId] = userPending;
        uint256 totalPending = $.totalPendingQCRedemption - amount;
        $.totalPendingQCRedemption = totalPending;

        $.qcTxToAmount[txHash] = amount;

        emit QCRedemptionFinalized(userId, amount, userPending, totalPending, txHash);
    }

    /// @inheritdoc IConcreteMerchant
    function initiateYieldAccrual(address vault, address yieldToken, uint256 amountInYieldToken, uint256 nonce)
        external
        whenNotPaused
    {
        if (amountInYieldToken == 0) {
            revert InvalidAmount();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        ConcreteMerchantStorageLib.VaultYieldConfig memory vaultConfig = $.vaultYieldConfigs[vault];
        if (vaultConfig.strategy == address(0) || vaultConfig.yieldMultisig == address(0)) {
            revert YieldConfigNotSet();
        }

        if (vaultConfig.strategy != msg.sender) {
            revert InvalidAddress();
        }

        if (!$.whitelistedYieldTokens.contains(yieldToken)) {
            revert YieldTokenNotWhitelisted(yieldToken);
        }

        if ($.pendingYieldByNonce[nonce] != 0) {
            revert YieldNonceAlreadyPending(nonce);
        }

        if (nonce != $.nextYieldNonce) {
            revert InvalidNonce($.nextYieldNonce, nonce);
        }

        $.pendingYieldByNonce[nonce] = amountInYieldToken;
        $.pendingYieldTokenByNonce[nonce] = yieldToken;
        $.nextYieldNonce = nonce + 1;

        uint256 totalPendingForToken = $.totalPendingYieldByToken[yieldToken] + amountInYieldToken;
        $.totalPendingYieldByToken[yieldToken] = totalPendingForToken;
        uint256 vaultPendingForToken = $.pendingYieldPerVaultByToken[vault][yieldToken] + amountInYieldToken;
        $.pendingYieldPerVaultByToken[vault][yieldToken] = vaultPendingForToken;

        IERC20(yieldToken).safeTransferFrom(vaultConfig.strategy, vaultConfig.yieldMultisig, amountInYieldToken);

        emit PendingYieldAccrual(
            nonce, yieldToken, vault, amountInYieldToken, totalPendingForToken, vaultPendingForToken
        );
    }

    /// @inheritdoc IConcreteMerchant
    function finalizeYieldAccrual(address vault, uint256 nonce, uint256 amountInAsset, bytes32 txHash)
        external
        whenNotPaused
        onlyRole(OPERATOR_ROLE)
    {
        if (txHash == bytes32(0)) {
            revert InvalidTxHash();
        }

        if (amountInAsset == 0) {
            revert InvalidAmount();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        if ($.qcTxToAmount[txHash] != 0) {
            revert TxHashAlreadyUsed(txHash);
        }

        uint256 pendingAmountInYieldToken = $.pendingYieldByNonce[nonce];
        if (pendingAmountInYieldToken == 0) {
            revert NoPendingYieldForNonce(nonce);
        }

        ConcreteMerchantStorageLib.VaultYieldConfig memory vaultConfig = $.vaultYieldConfigs[vault];
        if (vaultConfig.strategy == address(0)) {
            revert YieldConfigNotSet();
        }

        IMultisigStrategy strategy = IMultisigStrategy(vaultConfig.strategy);

        address recordedYieldToken = $.pendingYieldTokenByNonce[nonce];
        $.pendingYieldByNonce[nonce] = 0;
        $.pendingYieldTokenByNonce[nonce] = address(0);
        $.totalPendingYieldByToken[recordedYieldToken] -= pendingAmountInYieldToken;
        $.pendingYieldPerVaultByToken[vault][recordedYieldToken] -= pendingAmountInYieldToken;
        $.qcTxToAmount[txHash] = amountInAsset;

        AssetCX token = $.assetCX;
        token.mint(amountInAsset);

        IERC20 tokenInterface = IERC20(address(token));
        SafeERC20.forceApprove(tokenInterface, vaultConfig.strategy, amountInAsset);
        strategy.finalizeMerchantYieldAccrual(nonce, amountInAsset, recordedYieldToken);
        SafeERC20.forceApprove(tokenInterface, vaultConfig.strategy, 0);

        emit YieldAccrualFinalized(nonce, recordedYieldToken, vault, pendingAmountInYieldToken, amountInAsset, txHash);
    }

    /// @inheritdoc IConcreteMerchant
    function redeem(uint256 amount, address receiver) external whenNotPaused {
        if (amount == 0) {
            revert InvalidAmount();
        }
        if (receiver == address(0)) {
            revert InvalidAddress();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();
        AssetCX token = $.assetCX;

        // Record the redemption amount (additive) per receiver
        uint256 totalPending = $.pendingAssetCxRedemptionPerReceiver[receiver] + amount;
        $.pendingAssetCxRedemptionPerReceiver[receiver] = totalPending;

        // Transfer assetCX from msg.sender to this contract
        IERC20 tokenInterface = IERC20(address(token));
        SafeERC20.safeTransferFrom(tokenInterface, msg.sender, address(this), amount);

        token.burn(amount);

        emit AssetCxRedemption(receiver, amount, totalPending);
    }

    /// @inheritdoc IConcreteMerchant
    function finalizeAssetCxRedemption(address receiver, uint256 amount, bytes32 txHash)
        external
        whenNotPaused
        onlyRole(OPERATOR_ROLE)
    {
        if (txHash == bytes32(0)) {
            revert InvalidTxHash();
        }

        if (amount == 0) {
            revert InvalidAmount();
        }
        if (receiver == address(0)) {
            revert InvalidAddress();
        }

        ConcreteMerchantStorageLib.Storage storage $ = ConcreteMerchantStorageLib.fetch();

        if ($.qcTxToAmount[txHash] != 0) {
            revert TxHashAlreadyUsed(txHash);
        }

        uint256 pendingForReceiver = $.pendingAssetCxRedemptionPerReceiver[receiver];
        if (amount > pendingForReceiver) {
            revert WrongRedemptionAmount(amount, pendingForReceiver);
        }

        uint256 remainingPending = pendingForReceiver - amount;
        $.pendingAssetCxRedemptionPerReceiver[receiver] = remainingPending;

        $.qcTxToAmount[txHash] = amount;

        emit AssetCxRedemptionFinalized(receiver, amount, remainingPending, txHash);
    }

    /**
     * @notice Authorizes an upgrade to a new implementation
     * @dev Only addresses with DEFAULT_ADMIN_ROLE can authorize upgrades, and
     *      only after the upgrade selector has matured through the timelock.
     *      Emits {MerchantUpgradeAuthorized} in addition to OZ's {IERC1967.Upgraded}
     *      so monitoring can attribute the upgrade to the queued proposal that
     *      authorized it.
     */
    function _authorizeUpgrade(address newImplementation) internal override onlyRole(DEFAULT_ADMIN_ROLE) afterDelay {
        emit MerchantUpgradeAuthorized(newImplementation, msg.sender);
    }

    function _resolveVault(ConcreteMerchantStorageLib.Storage storage $, bytes32 userId)
        internal
        view
        returns (IERC4626 vault)
    {
        vault = $.userVaults[userId];
        if (address(vault) == address(0)) {
            vault = $.assetCXVault;
        }
    }
}

